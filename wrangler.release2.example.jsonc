{
  // Copy to wrangler.jsonc ONLY after creating a NEW dedicated D1 database.
  // Never reuse an MCP Jeopardy database UUID or Worker name.
  "name": "code-in-action-millionaire",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "code-in-action-millionaire-db", "database_id": "REPLACE_WITH_NEW_D1_UUID"}],
  "vars": {"REQUIRE_TURNSTILE": "true", "TURNSTILE_SITE_KEY": "REPLACE_WITH_NEW_SITE_KEY"},
  "triggers": {"crons": ["*/5 * * * *"]}
}
